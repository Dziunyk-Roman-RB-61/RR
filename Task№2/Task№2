#include <stdio.h>  // підключення стандартної бібліотеки вводу-виводу (printf, scanf, getchar)
#include <stdlib.h> // підключення бібліотеки з функціями динамічного виділення пам'яті (malloc, free)

// оголошення функції очищення буфера вводу від некоректних символів (прототип функції)
void clearInputBuffer(void);

// оголошення функції пошуку стовпця з найбільшою сумою елементів (прототип функції)
int findMaxSumColumn(double **A, int N, double *maxSum);

// оголошення функції виведення матриці на екран (прототип функції)
void printMatrix(double **A, int N);

// головна функція програми, з якої починається виконання програми
int main(void)
{
    int N = 0;            // оголошення змінної типу int (знакове ціле число) для розміру квадратної матриці, ініціалізація нулем
    double **A = NULL;    // оголошення вказівника на масив вказівників (двовимірний динамічний масив), ініціалізація нульовим вказівником
    int columnIndex = -1; // оголошення змінної для індексу стовпця з найбільшою сумою, початкове значення -1 означає "не знайдено"
    double maxSum = 0.0;  // оголошення змінної типу double (з плаваючою комою подвійної точності) для найбільшої суми стовпця

    // цикл із постумовою: повторюється, доки користувач не введе коректний розмір матриці
    do
    {
        printf("Enter the size of the square matrix N (N >= 1): "); // виведення на екран запрошення до введення розміру матриці

        // перевірка результату scanf: якщо не вдалося зчитати ціле число, то введення некоректне
        if (scanf("%d", &N) != 1)
        {
            printf("Error: an integer is required.\n"); // повідомлення про некоректний формат введених даних
            clearInputBuffer();                               // видалення з буфера вводу всіх символів до кінця рядка
            N = 0;                                            // присвоєння недопустимого значення, щоб цикл виконався повторно
        }
        else if (N < 1) // перевірка умови: розмір матриці має бути додатним
        {
            printf("Error: the value of N must be at least 1.\n"); // повідомлення про порушення умови N >= 1
        }
    } while (N < 1); // умова продовження циклу: повторне введення, доки N менше за одиницю

    A = (double **)malloc(N * sizeof(double *)); // виділення динамічної пам'яті під масив із N вказівників на рядки матриці

    // перевірка успішності виділення пам'яті: malloc повертає NULL у разі невдачі
    if (A == NULL)
    {
        printf("Error: memory allocation failed.\n"); // повідомлення про помилку виділення пам'яті
        return 1;                                          // завершення програми з ненульовим кодом, що означає помилку
    }

    // цикл з лічильником: виділення пам'яті під кожен рядок матриці
    for (int i = 0; i < N; i++)
    {
        A[i] = (double *)malloc(N * sizeof(double)); // виділення динамічної пам'яті під N елементів і-го рядка матриці

        // перевірка успішності виділення пам'яті для поточного рядка
        if (A[i] == NULL)
        {
            printf("Error: memory allocation failed.\n"); // повідомлення про помилку виділення пам'яті

            // цикл звільнення раніше виділених рядків, щоб уникнути витоку пам'яті
            for (int k = 0; k < i; k++)
            {
                free(A[k]); // звільнення пам'яті k-го рядка матриці
            }

            free(A); // звільнення пам'яті масиву вказівників
            return 1; // завершення програми з ненульовим кодом, що означає помилку
        }
    }

    printf("Enter the elements of matrix A (%d x %d):\n", N, N); // виведення на екран запрошення до введення елементів матриці

    // зовнішній цикл з лічильником: перебір рядків матриці
    for (int i = 0; i < N; i++)
    {
        // внутрішній цикл з лічильником: перебір стовпців поточного рядка
        for (int j = 0; j < N; j++)
        {
            // цикл із постумовою: повторне введення, доки елемент не буде успішно зчитаний
            int isRead = 0; // оголошення прапорця успішного зчитування елемента, початкове значення 0 (не зчитано)

            while (isRead == 0)
            {
                printf("A[%d][%d] = ", i, j); // виведення на екран запрошення до введення елемента з індексами i та j

                // перевірка результату scanf: якщо зчитано рівно одне дійсне число, введення коректне
                if (scanf("%lf", &A[i][j]) == 1)
                {
                    isRead = 1; // встановлення прапорця успішного зчитування, цикл буде завершено
                }
                else
                {
                    printf("Error: a number is required.\n"); // повідомлення про некоректний формат введених даних
                    clearInputBuffer();                          // видалення з буфера вводу всіх символів до кінця рядка
                }
            }
        }
    }

    columnIndex = findMaxSumColumn(A, N, &maxSum); // виклик функції пошуку; адреса maxSum передається для отримання значення суми

    printf("\nMatrix A:\n"); // виведення заголовка перед виведенням матриці
    printMatrix(A, N);       // виклик функції виведення матриці A на екран

    printf("\nIndex of the column with the largest sum: %d (zero-based)\n", columnIndex); // виведення індексу знайденого стовпця
    printf("Number of this column (one-based): %d\n", columnIndex + 1);                     // виведення номера стовпця для зручності користувача
    printf("Calculated column sum: %.4f\n", maxSum);                                  // виведення значення найбільшої суми

    // цикл з лічильником: звільнення пам'яті кожного рядка матриці
    for (int i = 0; i < N; i++)
    {
        free(A[i]); // звільнення пам'яті і-го рядка матриці
    }

    free(A); // звільнення пам'яті масиву вказівників на рядки

    return 0; // повернення коду 0 операційній системі, що означає успішне завершення програми
}

// визначення функції очищення буфера вводу, функція не приймає параметрів і не повертає значення
void clearInputBuffer(void)
{
    int ch = 0; // оголошення змінної типу int для зберігання поточного прочитаного символу

    // цикл зчитує символи по одному, доки не буде досягнуто кінець рядка або кінець файлу
    while ((ch = getchar()) != '\n' && ch != EOF)
    {
        // тіло циклу порожнє: усі прочитані символи відкидаються
    }
}

// визначення функції пошуку стовпця з найбільшою сумою; повертає індекс стовпця, а суму повертає через вказівник
int findMaxSumColumn(double **A, int N, double *maxSum)
{
    int bestColumn = 0;                   // оголошення змінної для індексу кращого стовпця, спочатку вважається першим стовпець з індексом 0
    double bestSum = 0.0;                 // оголошення змінної для найбільшої суми, обчислюється нижче для нульового стовпця

    // цикл з лічильником: обчислення суми елементів нульового стовпця як початкового значення для порівняння
    for (int i = 0; i < N; i++)
    {
        bestSum = bestSum + A[i][0]; // додавання елемента і-го рядка нульового стовпця до накопичуваної суми
    }

    // зовнішній цикл з лічильником: перебір решти стовпців матриці, починаючи з індексу 1
    for (int j = 1; j < N; j++)
    {
        double columnSum = 0.0; // оголошення змінної для суми поточного j-го стовпця, на початку кожної ітерації обнуляється

        // внутрішній цикл з лічильником: перебір усіх елементів поточного стовпця зверху вниз
        for (int i = 0; i < N; i++)
        {
            columnSum = columnSum + A[i][j]; // додавання елемента і-го рядка j-го стовпця до суми поточного стовпця
        }

        // порівняння: якщо сума поточного стовпця строго більша за найбільшу знайдену, то оновлюємо результат
        if (columnSum > bestSum)
        {
            bestSum = columnSum; // запам'ятовування нового найбільшого значення суми
            bestColumn = j;      // запам'ятовування індексу стовпця, який має нову найбільшу суму
        }
    }

    *maxSum = bestSum; // запис знайденої найбільшої суми за адресою, переданою через вказівник maxSum

    return bestColumn; // повернення індексу стовпця з найбільшою сумою у місце виклику функції
}

// визначення функції виведення матриці на екран, функція не повертає значення
void printMatrix(double **A, int N)
{
    // зовнішній цикл з лічильником: перебір рядків матриці
    for (int i = 0; i < N; i++)
    {
        // внутрішній цикл з лічильником: перебір елементів поточного рядка
        for (int j = 0; j < N; j++)
        {
            printf("%9.2f ", A[i][j]); // виведення елемента в полі шириною 9 символів із двома знаками після коми
        }

        printf("\n"); // перехід на новий рядок після виведення всіх елементів поточного рядка матриці
    }
}
